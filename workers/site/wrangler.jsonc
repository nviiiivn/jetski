// bcw-site — the static page (dist/, built by `npm run build`) plus a
// pass-through of /snapshot, /forecast and /admin to bcw-data.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bcw-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Data routes skip the asset lookup and go straight to the Worker.
    "run_worker_first": ["/snapshot*", "/forecast*", "/admin/*"]
  },

  "services": [{ "binding": "DATA", "service": "bcw-data" }]

  // To serve on your own domain instead of bcw-site.<account>.workers.dev:
  // "routes": [{ "pattern": "coast.example.com", "custom_domain": true }]
}
